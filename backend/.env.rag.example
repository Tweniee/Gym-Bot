# ============================================================================
# RAG Database Ingestion System - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your configuration

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# MongoDB Configuration (RAG Database Source)
# ----------------------------------------------------------------------------
# Database type (currently only mongodb supported, postgres/mysql planned)
DB_TYPE=mongodb

# MongoDB connection string
# Format: mongodb://[username:password@]host[:port]
# Examples:
#   Local: mongodb://localhost:27017
#   Docker: mongodb://mongodb:27017
#   Atlas: mongodb+srv://user:pass@cluster.mongodb.net
DB_URI=mongodb://localhost:27017

# Database name
DB_NAME=app_db

# Collections to index for RAG (comma-separated)
# Leave empty to allow all collections (not recommended for production)
# Examples:
#   Single: products
#   Multiple: products,users,orders,articles
RAG_COLLECTIONS=products,users,orders

# ----------------------------------------------------------------------------
# Ollama Configuration (Embedding & Chat)
# ----------------------------------------------------------------------------
# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model for vector generation
# Options: nomic-embed-text, mxbai-embed-large, all-minilm
# Recommended: nomic-embed-text (768 dimensions, fast, good quality)
EMBEDDING_MODEL=nomic-embed-text

# Chat model for question answering
# Options: llama3, llama2, mistral, mixtral, phi
# Recommended: llama3 (best quality)
CHAT_MODEL=llama3

# ----------------------------------------------------------------------------
# Qdrant Configuration (Vector Database)
# ----------------------------------------------------------------------------
# Qdrant server URL
QDRANT_URL=http://localhost:6333

# Collection name for storing vectors
# All RAG vectors will be stored in this collection
QDRANT_COLLECTION_NAME=documents

# ----------------------------------------------------------------------------
# RAG Configuration (Chunking & Retrieval)
# ----------------------------------------------------------------------------
# Maximum characters per chunk
# Larger = more context per chunk, fewer chunks
# Smaller = more granular retrieval, more chunks
# Recommended: 600 for balanced performance
CHUNK_SIZE=600

# Overlap between chunks (characters)
# Helps preserve context across chunk boundaries
# Recommended: 10-15% of CHUNK_SIZE
CHUNK_OVERLAP=90

# Number of similar chunks to retrieve for each query
# Higher = more context but slower
# Lower = faster but may miss relevant info
# Recommended: 5
TOP_K=5

# Minimum similarity score for retrieval (0.0 to 1.0)
# Higher = more strict matching
# Lower = more lenient matching
# Recommended: 0.5
SIMILARITY_THRESHOLD=0.5

# ----------------------------------------------------------------------------
# File Upload Configuration (Legacy - for file-based ingestion)
# ----------------------------------------------------------------------------
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# Upload directory for file-based ingestion
UPLOAD_DIR=./uploads

# Auto-ingest directory for file-based ingestion
AUTO_INGEST_DIR=./documents

# ----------------------------------------------------------------------------
# RAG Webhook Configuration (Optional)
# ----------------------------------------------------------------------------
# Webhook endpoint path (default: /rag/webhook)
# RAG_WEBHOOK_PATH=/rag/webhook

# Webhook authentication token (recommended for production)
# RAG_WEBHOOK_TOKEN=your-secret-token-here

# Webhook rate limit (requests per minute)
# RAG_WEBHOOK_RATE_LIMIT=100

# ----------------------------------------------------------------------------
# Advanced MongoDB Configuration (Optional)
# ----------------------------------------------------------------------------
# MongoDB connection pool size
# DB_POOL_SIZE_MIN=2
# DB_POOL_SIZE_MAX=10

# MongoDB connection timeout (milliseconds)
# DB_CONNECTION_TIMEOUT=5000

# MongoDB socket timeout (milliseconds)
# DB_SOCKET_TIMEOUT=45000

# ----------------------------------------------------------------------------
# Advanced Embedding Configuration (Optional)
# ----------------------------------------------------------------------------
# Batch size for embedding generation
# Higher = faster but more memory
# Lower = slower but less memory
# EMBEDDING_BATCH_SIZE=10

# Embedding generation timeout (milliseconds)
# EMBEDDING_TIMEOUT=30000

# ----------------------------------------------------------------------------
# Logging Configuration (Optional)
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug
# LOG_LEVEL=info

# Log format: json, pretty
# LOG_FORMAT=pretty

# ----------------------------------------------------------------------------
# Production Configuration (Optional)
# ----------------------------------------------------------------------------
# Enable CORS (comma-separated origins)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Enable request logging
# REQUEST_LOGGING=true

# Enable performance monitoring
# PERFORMANCE_MONITORING=true

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Never commit .env files to version control
# 2. Use strong authentication for production MongoDB
# 3. Enable MongoDB authentication in production
# 4. Use HTTPS for all production endpoints
# 5. Implement rate limiting for webhook endpoint
# 6. Monitor embedding generation performance
# 7. Set up alerts for ingestion failures
# 8. Regularly backup MongoDB and Qdrant data
# 9. Test disaster recovery procedures
# 10. Review and rotate secrets regularly

# ----------------------------------------------------------------------------
# Quick Start
# ----------------------------------------------------------------------------
# 1. Copy this file: cp .env.rag.example .env
# 2. Update DB_URI, DB_NAME, and RAG_COLLECTIONS
# 3. Start services: docker-compose up -d
# 4. Pull models: docker exec ollama ollama pull nomic-embed-text
# 5. Start server: npm run dev
# 6. Test webhook: ./test-rag-webhook.sh

# ----------------------------------------------------------------------------
# Support
# ----------------------------------------------------------------------------
